{
  "name": "inventory-reservation-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "db:migrate": "npm run db:migrate --workspace @inventory/api",
    "dev": "npm run dev --workspace @inventory/api",
    "dev:web": "npm run dev --workspace @inventory/web",
    "lint": "eslint .",
    "start": "npm run start --workspace @inventory/api",
    "test": "npm run test:unit && npm run test:web",
    "test:all": "npm test && npm run test:integration",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:web": "vitest run --config apps/web/vitest.config.ts",
    "typecheck": "npm run typecheck:api && npm run typecheck --workspace @inventory/web",
    "typecheck:api": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
